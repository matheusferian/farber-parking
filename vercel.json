{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh vercel-build.sh",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/events/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/events/makers-halloween-2026", "destination": "/events/makers-halloween-2026/index.html" },
    { "source": "/events/makers-halloween-2026/t", "destination": "/events/makers-halloween-2026/t.html" },
    { "source": "/events/makers-halloween-2026/", "destination": "/events/makers-halloween-2026/index.html" }
  ]
}
